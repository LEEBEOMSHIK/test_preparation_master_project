# Database
DB_PASSWORD=change_me

# JWT
JWT_SECRET=change_me_to_a_256bit_random_secret_value_here

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# File Upload (bytes: 10MB default)
MAX_FILE_SIZE=10485760

# Frontend API URL (used at build time for Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Notion OAuth (개념노트 연동) — https://www.notion.so/my-integrations 에서 Public integration 발급
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8080/api/notion/callback

# 외부 access token 암호화 키
TOKEN_ENCRYPTION_KEY=change_me_to_a_random_value
# 키 회전 시에만 옛 키 지정 → 기동 시 저장 토큰을 새 키로 재암호화(사용자 재연결 불필요).
# 마이그레이션 완료 후 비워두면 됨.
TOKEN_ENCRYPTION_KEY_PREVIOUS=
