# ==============================================================
# TPMP Dev 환경 변수 템플릿
# 복사 후 .env.dev로 저장하여 사용한다.
# 사용법: docker-compose -f docker-compose.yml -f docker-compose.dev.yml --env-file .env.dev up -d
# ==============================================================

SPRING_PROFILES_ACTIVE=dev

# ── Database ─────────────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_NAME=tpmp
DB_USERNAME=tpmp
DB_PASSWORD=your_db_password_here

# ── JWT (256비트 이상 랜덤 문자열) ───────────────────────────
JWT_SECRET=your_jwt_secret_256bit_here

# ── Token Encryption ──────────────────────────────────────────
# 키 회전 시에만 TOKEN_ENCRYPTION_KEY_PREVIOUS를 이전 키로 지정
TOKEN_ENCRYPTION_KEY=your_token_encryption_key_here
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# ── Anthropic AI ─────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_PROVIDER=anthropic

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://dev.example.com

# ── Google OAuth2 ────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH2_REDIRECT_URI=https://dev.example.com/api/login/oauth2/code/google
OAUTH2_FRONTEND_REDIRECT_URI=https://dev.example.com/auth/oauth/callback

# ── Notion Integration ───────────────────────────────────────
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=https://dev.example.com/api/notion/callback
NOTION_SUCCESS_REDIRECT=https://dev.example.com/user/settings?notion=connected
NOTION_FAILURE_REDIRECT=https://dev.example.com/user/settings?notion=failed

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://dev.example.com/api

# ── Upload ───────────────────────────────────────────────────
UPLOAD_PATH=/uploads
MAX_FILE_SIZE=10MB
