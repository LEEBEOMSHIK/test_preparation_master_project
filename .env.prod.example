# ==============================================================
# TPMP Prod 환경 변수 템플릿
# 복사 후 .env.prod로 저장하여 사용한다.
# 주의: 모든 플레이스홀더를 실제 프로덕션 값으로 교체한 후 사용할 것.
#        이 파일(.env.prod.example)은 git에 커밋되므로 실제 시크릿을 절대 기입하지 않는다.
# 사용법: docker-compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d
# ==============================================================

SPRING_PROFILES_ACTIVE=prod

# ── Database ─────────────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_NAME=tpmp
DB_USERNAME=tpmp
DB_PASSWORD=

# ── JWT (256비트 이상 랜덤 문자열 필수) ─────────────────────
JWT_SECRET=

# ── Token Encryption ──────────────────────────────────────────
# 키 회전 시에만 TOKEN_ENCRYPTION_KEY_PREVIOUS를 이전 키로 지정
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# ── Anthropic AI ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
AI_PROVIDER=anthropic

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://example.com

# ── Google OAuth2 ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH2_REDIRECT_URI=https://example.com/api/login/oauth2/code/google
OAUTH2_FRONTEND_REDIRECT_URI=https://example.com/auth/oauth/callback

# ── Notion Integration ───────────────────────────────────────
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=https://example.com/api/notion/callback
NOTION_SUCCESS_REDIRECT=https://example.com/user/settings?notion=connected
NOTION_FAILURE_REDIRECT=https://example.com/user/settings?notion=failed

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://example.com/api

# ── Upload ───────────────────────────────────────────────────
UPLOAD_PATH=/uploads
MAX_FILE_SIZE=10MB
