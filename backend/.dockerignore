# Gradle 빌드 산출물 (COPY 대상 아님 — 컨테이너 내부에서 새로 빌드)
build/
.gradle/
bin/
logs/

# 컴파일 산출물 / 로그
*.class
*.log

# 환경변수 (시크릿 — 빌드 컨텍스트에 포함 금지)
.env
.env.*

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# git
.git

# 런타임 업로드 (컨테이너가 자체적으로 /uploads 생성)
uploads/

# jar 산출물 제외, 단 gradlew 실행에 필요한 wrapper jar는 예외
*.jar
!gradle/wrapper/gradle-wrapper.jar

# src/test/ 는 제외하지 않음 — ./gradlew bootJar가 테스트 소스 컴파일을 필요로 할 수 있음
